{
  "name": "attendance-management-server",
  "version": "1.0.0",
  "description": "REST API for an employee attendance management system (Node.js, Express, MongoDB, JWT)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --detectOpenHandles",
